# =====================================================
# Docker Hub (usado pelas pipelines e docker-compose)
# =====================================================
DOCKERHUB_USERNAME=seu-usuario
IMAGE_TAG=latest

# =====================================================
# Backend - Application
# =====================================================
NODE_ENV=production
PORT=3000

# =====================================================
# Backend - PostgreSQL
# ATENÇÃO: No Docker, DB_HOST deve ser "postgres" (nome do serviço)
# =====================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce123
DB_POOL_MIN=2
DB_POOL_MAX=10

# =====================================================
# Backend - Redis
# ATENÇÃO: No Docker, REDIS_HOST deve ser "redis" (nome do serviço)
# =====================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =====================================================
# Backend - Rate Limit
# =====================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# Frontend (Vite)
# =====================================================
VITE_API_URL=http://localhost:3000

# =====================================================
# Grafana
# =====================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# =====================================================
# Variáveis para o PostgreSQL Container
# (o container precisa dessas para criar o DB/User)
# =====================================================
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce123
POSTGRES_DB=ecommerce